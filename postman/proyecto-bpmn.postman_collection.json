        {
          "name": "Iniciar solicitud con plazo corto (plazoRespuesta)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances"
              ]
            },
            "description": "plazoRespuesta (duración ISO 8601) reemplaza los 5 días del timer Plazo sin tocar el modelo. PT20S: cada vencimiento tarda ~24 s. Sin la variable, el plazo es P5D.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Solicitud de curso\",\n  \"businessKey\": \"{{cursoId}}\",\n  \"variables\": [\n    {\n      \"name\": \"cursoId\",\n      \"value\": {{cursoId}},\n      \"type\": \"integer\"\n    },\n    {\n      \"name\": \"empresaId\",\n      \"value\": {{empresaId}},\n      \"type\": \"integer\"\n    },\n    {\n      \"name\": \"plazoRespuesta\",\n      \"value\": \"PT20S\",\n      \"type\": \"string\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Instancia creada (201)', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('processInstanceId', j.id);",
                  "console.log('processInstanceId = ' + j.id);"
                ]
              }
            }
          ]
        },
