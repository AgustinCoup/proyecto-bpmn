{
  "info": {
    "name": "Proyecto BPMN - Flowable REST",
    "description": "Pruebas de la API REST de Flowable. Cambiá las variables de la colección (usuario, clave, ids) según lo que quieras probar. Los puntos marcados (verificar) son suposiciones de Contrato.md. Para desplegar el DMN y los timers cortos de las pruebas usar usuario rest-admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{usuario}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{clave}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/flowable-rest/service"
    },
    {
      "key": "usuario",
      "value": "jefeAdmin"
    },
    {
      "key": "clave",
      "value": "test"
    },
    {
      "key": "processKey",
      "value": "Process_Curso"
    },
    {
      "key": "processInstanceId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "executionId",
      "value": ""
    },
    {
      "key": "dmnUrl",
      "value": "http://localhost:8080/flowable-rest/dmn-api"
    },
    {
      "key": "mensaje",
      "value": "Aceptación"
    }
  ],
  "item": [
    {
      "name": "1. Identidad",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/identity/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "users"
              ]
            }
          }
        },
        {
          "name": "Listar grupos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/identity/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "groups"
              ]
            }
          }
        },
        {
          "name": "Miembros del grupo administracion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/identity/users?memberOfGroup=administracion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "users"
              ],
              "query": [
                {
                  "key": "memberOfGroup",
                  "value": "administracion"
                }
              ]
            }
          }
        },
        {
          "name": "Miembros del grupo docentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/identity/users?memberOfGroup=docentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "users"
              ],
              "query": [
                {
                  "key": "memberOfGroup",
                  "value": "docentes"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Despliegue",
      "item": [
        {
          "name": "Desplegar BPMN / DMN",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repository/deployments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repository",
                "deployments"
              ]
            },
            "description": "Elegí el archivo .bpmn20.xml o .dmn en el campo \"file\".",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Listar despliegues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repository/deployments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repository",
                "deployments"
              ]
            }
          }
        },
        {
          "name": "Listar definiciones del proceso",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repository/process-definitions?key={{processKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repository",
                "process-definitions"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{processKey}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Instancias",
      "item": [
        {
          "name": "Iniciar por clave",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"processDefinitionKey\": \"{{processKey}}\",\n  \"variables\": [\n    {\n      \"name\": \"simularFaltaAulas\",\n      \"value\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances"
              ]
            },
            "description": "Sirve si el proceso arranca con un inicio \"none\". Con inicio por mensaje, usar la siguiente (verificar)."
          }
        },
        {
          "name": "Iniciar por mensaje Solicitud de curso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Solicitud de curso\",\n  \"businessKey\": \"101\",\n  \"variables\": [\n    {\n      \"name\": \"cursoId\",\n      \"value\": 101,\n      \"type\": \"integer\"\n    },\n    {\n      \"name\": \"empresaId\",\n      \"value\": 7,\n      \"type\": \"integer\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances"
              ]
            },
            "description": "Verificado: Flowable 6.8 acepta \"message\" (el nombre, no el id Msg_sol). La regla DMN rechaza el inicio si ya hay 5 otras instancias de Process_Curso sin finalizar: la instancia termina NO_VIABLE."
          }
        },
        {
          "name": "Listar instancias en curso",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances"
              ]
            }
          }
        },
        {
          "name": "Ver variables de una instancia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances/{{processInstanceId}}/variables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances",
                "{{processInstanceId}}",
                "variables"
              ]
            }
          }
        },
        {
          "name": "Instancias no finalizadas (historial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/history/historic-process-instances?finished=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "history",
                "historic-process-instances"
              ],
              "query": [
                {
                  "key": "finished",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Borrar una instancia",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances/{{processInstanceId}}?deleteReason=prueba",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances",
                "{{processInstanceId}}"
              ],
              "query": [
                {
                  "key": "deleteReason",
                  "value": "prueba"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Tareas",
      "item": [
        {
          "name": "Mis tareas asignadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/tasks?assignee={{usuario}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "tasks"
              ],
              "query": [
                {
                  "key": "assignee",
                  "value": "{{usuario}}"
                }
              ]
            }
          }
        },
        {
          "name": "Tareas candidatas del grupo administracion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/tasks?candidateGroup=administracion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "tasks"
              ],
              "query": [
                {
                  "key": "candidateGroup",
                  "value": "administracion"
                }
              ]
            }
          }
        },
        {
          "name": "Tareas candidatas del grupo docentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/tasks?candidateGroup=docentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "tasks"
              ],
              "query": [
                {
                  "key": "candidateGroup",
                  "value": "docentes"
                }
              ]
            }
          }
        },
        {
          "name": "Reclamar tarea (claim)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"claim\",\n  \"assignee\": \"{{usuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        },
        {
          "name": "Completar tarea",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"complete\",\n  \"variables\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Mensajes de la empresa",
      "item": [
        {
          "name": "Buscar ejecuciones de una instancia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/executions?processInstanceId={{processInstanceId}}&messageEventSubscriptionName={{mensaje}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "executions"
              ],
              "query": [
                {
                  "key": "processInstanceId",
                  "value": "{{processInstanceId}}"
                },
                {
                  "key": "messageEventSubscriptionName",
                  "value": "{{mensaje}}",
                  "description": "Nombre del mensaje, p. ej. Aceptación, Rechazo, Solicitud de modificaciones. Si la lista viene vacía, ese mensaje no está habilitado ahora. Guardá data[0].id en executionId."
                }
              ]
            }
          }
        },
        {
          "name": "Aceptar propuesta (con fecha)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"messageEventReceived\",\n  \"messageName\": \"Aceptación\",\n  \"variables\": [\n    {\n      \"name\": \"fechaCurso\",\n      \"value\": \"2026-12-01T09:00:00Z\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/executions/{{executionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "executions",
                "{{executionId}}"
              ]
            },
            "description": "PUT sobre la ejecución del evento \"Aceptación\" (ver \"Buscar ejecuciones de una instancia\" con messageEventSubscriptionName=Aceptación). Responde 204: la instancia sigue en Preparar. Formato de fechaCurso aceptado por el timer Fecha: ISO 8601 con o sin zona (\"2026-12-01T09:00:00\" se toma como UTC), con offset, o sólo fecha."
          }
        },
        {
          "name": "Rechazar propuesta",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"messageEventReceived\",\n  \"messageName\": \"Rechazo\",\n  \"variables\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/executions/{{executionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "executions",
                "{{executionId}}"
              ]
            }
          }
        },
        {
          "name": "Pedir modificaciones",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"messageEventReceived\",\n  \"messageName\": \"Solicitud de modificaciones\",\n  \"variables\": [\n    {\n      \"name\": \"observaciones\",\n      \"value\": \"Texto del pedido\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/executions/{{executionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "executions",
                "{{executionId}}"
              ]
            }
          }
        },
        {
          "name": "Cancelar curso",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"messageEventReceived\",\n  \"messageName\": \"Cancelación\",\n  \"variables\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/executions/{{executionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "executions",
                "{{executionId}}"
              ]
            }
          }
        },
        {
          "name": "Enviar nomina (recibirNomina)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"signal\",\n  \"variables\": [\n    {\n      \"name\": \"participantes\",\n      \"value\": \"Ana;Beto;Carla\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/runtime/executions/{{executionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "executions",
                "{{executionId}}"
              ]
            },
            "description": "PUT (no POST). Acción signal/trigger sin verificar todavía: se prueba con el escenario 1."
          }
        }
      ]
    },
    {
      "name": "6. Viabilidad y plazos (fase 4)",
      "item": [
        {
          "name": "Desplegar DMN (motor DMN)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{dmnUrl}}/dmn-repository/deployments",
              "host": [
                "{{dmnUrl}}"
              ],
              "path": [
                "dmn-repository",
                "deployments"
              ]
            },
            "description": "Antes de iniciar instancias. Elegí modelo/viabilidadCurso.dmn en el campo \"file\". Usar usuario rest-admin.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Listar despliegues DMN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{dmnUrl}}/dmn-repository/deployments",
              "host": [
                "{{dmnUrl}}"
              ],
              "path": [
                "dmn-repository",
                "deployments"
              ]
            },
            "description": "Debe quedar vacío al terminar las pruebas."
          }
        },
        {
          "name": "Iniciar solicitud con plazo corto (plazoRespuesta)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances"
              ]
            },
            "description": "plazoRespuesta (duración ISO 8601) reemplaza los 5 días del timer Plazo sin tocar el modelo. PT20S: cada vencimiento tarda ~24 s. Sin la variable, el plazo es P5D.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Solicitud de curso\",\n  \"businessKey\": \"401\",\n  \"variables\": [\n    {\n      \"name\": \"cursoId\",\n      \"value\": 401,\n      \"type\": \"integer\"\n    },\n    {\n      \"name\": \"empresaId\",\n      \"value\": 7,\n      \"type\": \"integer\"\n    },\n    {\n      \"name\": \"plazoRespuesta\",\n      \"value\": \"PT20S\",\n      \"type\": \"string\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ver cursosEnEjecucion de una instancia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances/{{processInstanceId}}/variables/cursosEnEjecucion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances",
                "{{processInstanceId}}",
                "variables",
                "cursosEnEjecucion"
              ]
            },
            "description": "Entrada de la regla DMN: cantidad de OTRAS instancias de Process_Curso sin finalizar. Si la instancia ya terminó (p. ej. NO_VIABLE), da 404: usar la consulta histórica de abajo."
          }
        },
        {
          "name": "Ver cursosEnEjecucion (historial, sirve si terminó)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/history/historic-variable-instances?processInstanceId={{processInstanceId}}&variableName=cursosEnEjecucion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "history",
                "historic-variable-instances"
              ],
              "query": [
                {
                  "key": "processInstanceId",
                  "value": "{{processInstanceId}}"
                },
                {
                  "key": "variableName",
                  "value": "cursosEnEjecucion"
                }
              ]
            }
          }
        },
        {
          "name": "Instancias activas de Process_Curso (las que cuenta la regla)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/process-instances?processDefinitionKey={{processKey}}&size=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "process-instances"
              ],
              "query": [
                {
                  "key": "processDefinitionKey",
                  "value": "{{processKey}}"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            },
            "description": "Si hay 5 o más, la próxima solicitud termina NO_VIABLE. Borrarlas con \"Borrar una instancia\" antes de probar otros escenarios."
          }
        },
        {
          "name": "Timers pendientes de una instancia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/management/timer-jobs?processInstanceId={{processInstanceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "management",
                "timer-jobs"
              ],
              "query": [
                {
                  "key": "processInstanceId",
                  "value": "{{processInstanceId}}"
                }
              ]
            },
            "description": "Con la instancia esperando respuesta hay un timer (Plazo). Durante la revisión de una modificación no hay ninguno."
          }
        }
      ]
    }
  ]
}
